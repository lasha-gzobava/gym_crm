<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- [%X{txId}] prints the transaction id from MDC -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] [%X{txId}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
